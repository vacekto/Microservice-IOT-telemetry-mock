{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".int-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@consumer/(.*)$": "<rootDir>/apps/consumer/src/$1",
    "^@producer/(.*)$": "<rootDir>/apps/producer/src/$1",
    "^libs/shared$": "<rootDir>/libs/shared",
    "^@app/shared/(.*)$": "<rootDir>/libs/shared/$1",
    "^libs/shared/(.*)$": "<rootDir>/libs/shared/$1"
  }
}
