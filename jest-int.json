{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".int-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@app/shared(.*)$": "<rootDir>/libs/shared/src$1",
    "^apps/consumer/src/(.*)$": "<rootDir>/apps/consumer/src/$1"
  }
}
